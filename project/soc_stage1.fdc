define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}

# Board KEY0: C22, active low.
define_attribute {p:key0_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key0_n} {PAP_IO_LOC} {C22}
define_attribute {p:key0_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key0_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key0_n} {PAP_IO_NONE} {TRUE}

# 27 MHz reference -> vendor GPLL -> 50 MHz, preserve the clock relationship.
# FDC hierarchy uses dot separators; slash separates instance and pin (UCE p85).
create_generated_clock -name {clk_sys} -source [get_ports {clk}] -multiply_by {100} -divide_by {27} [get_pins {u_clk_rst.u_pll.u_gpll/CLKOUT0}]

# PLL reset is produced in the 27 MHz reference domain. Its release is
# intentionally asynchronous at ONLY the three reset-synchronizer stages.
# The pipeline output -> UART/heartbeat recovery/removal paths remain timed.
set_false_path -from [get_cells {u_clk_rst.pll_rst}] -to [get_cells {u_clk_rst.u_sys_reset.release_pipe[*]}]
# The GPLL LOCK pin is an asynchronous status output, not a legal PDS STA
# launch startpoint. No fictitious clock or non-matching exception is added.
# Its consumers are physically the reset bank and the first lock indicator FF.
define_attribute {p:key1_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key1_n} {PAP_IO_LOC} {C23}
define_attribute {p:key1_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key1_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key1_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx} {PAP_IO_NONE} {TRUE}
# Only asynchronous input -> first synchronizer stage; later paths timed.
set_false_path -from [get_ports {key1_n}] -to [get_cells {system.subsystem.registers.key_meta}]
set_false_path -from [get_ports {uart_rx}] -to [get_cells {system.subsystem.serial.rx_meta}]

