      <value>NORMAL_WRITE</value>
    </param>
    <param>
      <name>A_CLK_EN</name>
      <value>true</value>
    </param>
    <param>
      <name>A_ADDR_STROBE_EN</name>
      <value>false</value>
    </param>
    <param>
