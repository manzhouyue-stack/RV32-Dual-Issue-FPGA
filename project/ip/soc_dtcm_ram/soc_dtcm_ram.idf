<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100201</id>
        <display_name>DRM Based Dual Port RAM</display_name>
        <name>28nm DRM Based Dual Port RAM</name>
        <version>1.10</version>
        <instance>soc_dtcm_ram</instance>
