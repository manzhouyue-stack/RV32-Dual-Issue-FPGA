      <value>false</value>
    </param>
    <param>
      <name>A_CLK_OR_POL_INV</name>
      <value>0</value>
    </param>
    <param>
      <name>A_FAB_REG</name>
      <value>0</value>
    </param>
    <param>
      <name>B_ADDR_WIDTH</name>
      <value>13</value>
    </param>
    <param>
      <name>B_DATA_WIDTH</name>
      <value>32</value>
    </param>
    <param>
      <name>B_BE_WIDTH</name>
      <value>4</value>
    </param>
    <param>
      <name>B_WRITE_MODE</name>
      <value>NORMAL_WRITE</value>
    </param>
    <param>
      <name>B_CLK_EN</name>
      <value>true</value>
    </param>
    <param>
      <name>B_ADDR_STROBE_EN</name>
      <value>false</value>
    </param>
    <param>
      <name>B_OUTPUT_REG</name>
      <value>false</value>
    </param>
    <param>
      <name>B_RD_OCE_EN</name>
      <value>false</value>
    </param>
    <param>
      <name>B_CLK_OR_POL_INV</name>
      <value>0</value>
    </param>
    <param>
      <name>B_FAB_REG</name>
      <value>0</value>
    </param>
    <param>
      <name>INIT_EN</name>
      <value>true</value>
    </param>
    <param>
      <name>INIT_FILE</name>
